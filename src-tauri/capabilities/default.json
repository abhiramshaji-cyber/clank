{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Clank default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" }
      ]
    },
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
